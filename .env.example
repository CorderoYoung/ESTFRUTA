# Configuracion de build de Create React App.
# OJO: este archivo esta en .gitignore, asi que NO se versiona.
# La copia versionada de referencia es .env.example.

# 2026-11-08: sin esto el build crashea con
#   DataCloneError: Data cannot be cloned, out of memory
# react-scripts 5 minifica en paralelo con jest-worker; al devolver el
# resultado al hilo principal los source maps no entran en memoria.
# Los source maps solo sirven para depurar en el navegador: en produccion
# no hacen falta y el build queda mas rapido.
GENERATE_SOURCEMAP=false
